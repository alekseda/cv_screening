# Copy this file to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://cvscreen:cvscreen@localhost:5432/cvscreen

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Used from Phase 2 (resume parsing) onward
ANTHROPIC_API_KEY=

# Model tiering (efficiency pass). Resume STRUCTURING runs on the cheaper
# default model first and auto-escalates to ANTHROPIC_MODEL only when the
# result looks unreliable. Job-relevance judgement always uses ANTHROPIC_MODEL
# (it needs stronger reasoning). Both are optional - these are the defaults:
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MODEL_STRUCTURING_DEFAULT=claude-haiku-4-5-20251001

# Bulk-upload concurrency (efficiency pass): how many resumes' extract/
# structure/embed pipelines run at once. Raise if your Anthropic/Voyage rate
# limits allow; lower if you see 429s on large batch uploads. Default is 8.
# MAX_CONCURRENT_PARSES=8

# Used from Phase 3 (embeddings) onward
VOYAGE_API_KEY=

RESUME_STORAGE_DIR=./storage/resumes

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
